# Configuracoes da Aplicacao (FastAPI)
APP_ENV=development
SECRET_KEY=sua_chave_secreta_para_jwt_substitua_em_producao
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuracoes do Banco de Dados (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=compex_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de Conexao com o Banco (Usada pelo SQLAlchemy / AsyncPG / SQLModel)
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
